# Copy to .env.local for local development (or set these in your shell)

# Required for admin login (NextAuth) — also set in Vercel Project → Settings → Environment Variables
AUTH_SECRET="arshia-global-bd-local-dev-secret-change-me"
AUTH_URL="http://localhost:3000"

# Demo admin login (when DATABASE_URL is not set)
DEMO_ADMIN_EMAIL="demo@arshialtd.com"
DEMO_ADMIN_PASSWORD="demo123"
DEMO_ADMIN_NAME="Demo Admin"

# Optional: show demo credentials on the login form
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="demo@arshialtd.com"
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="demo123"

# PostgreSQL (optional — add when ready for persistent CMS)
# DATABASE_URL="postgresql://user:pass@localhost:5432/arshia_global_bd"

# DB seed admin (after DATABASE_URL is configured)
# ADMIN_SEED_EMAIL="admin@arshialtd.com"
# ADMIN_SEED_PASSWORD="change-me"
# ADMIN_SEED_NAME="Site Admin"
